# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_API_KEY: Secret key required for server-side administrator PDF upload API.
# Keep strictly secret and never expose to the client-side bundle.
ADMIN_API_KEY="infostaan_admin_secure_secret_key"

# Razorpay API credentials (use test keys until production is ready).
# Keep both values server-side; never use a VITE_ prefix.
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
# Optional: temporary fixed price per PDF in paise (100 = ₹1). Remove after testing.
# RAZORPAY_FIXED_PDF_PRICE_PAISE=100
# Explicitly enable the standalone real ₹1 integration-test payment and QR (not a PDF purchase).
# RAZORPAY_ENABLE_TEST_PAYMENT=true

# Port for backend Express server
PORT=5000

# Public frontend setting for a separately hosted backend. Leave blank for the local Vite proxy.
VITE_API_BASE_URL=""

# Course inquiry Google Sheet (server-only credentials; never use a VITE_ prefix).
GOOGLE_SHEETS_SPREADSHEET_ID="your-spreadsheet-id"
GOOGLE_SHEETS_RANGE="Inquiries!A:I"
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----\n"
